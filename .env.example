# ── Browser (safe to expose; protected by row-level security) ──
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Server only (Vercel → Project → Settings → Environment Variables) ──
# Never prefix these with VITE_ — that would ship them to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app, used in email links and the same-origin check
APP_URL=https://madfocus.yourdomain.com

# Branded email via Resend (https://resend.com). Verify your domain there first.
# Leave RESEND_API_KEY empty to fall back to Supabase's mailer + templates in supabase/templates.
RESEND_API_KEY=
MAIL_FROM=Mad Focus <hello@yourdomain.com>
MAIL_REPLY_TO=

# AI coach
ANTHROPIC_API_KEY=
